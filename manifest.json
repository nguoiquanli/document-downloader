{
  "manifest_version": 3,
  "name": "Document Downloader",
  "version": "2.0.0",
  "description": "Tải tài liệu từ Studocu, Scribd và SlideShare.",
  "icons": {
    "16": "assets/icons/16.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "host_permissions": [
    "https://doc-assets.studocu.com/*",
    "https://*.studocu.com/*",
    "https://*.studeersnel.nl/*",
    "https://*.studocu.vn/*",
    "https://www.scribd.com/*",
    "https://scribd.com/*",
    "https://www.slideshare.net/*",
    "https://slideshare.net/*",
    "https://*.slideshare.net/*",
    "https://image.slidesharecdn.com/*",
    "https://*.slidesharecdn.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.studocu.com/*",
        "https://*.studocu.com/*",
        "https://www.studeersnel.nl/*",
        "https://*.studeersnel.nl/*",
        "https://www.studocu.vn/*",
        "https://*.studocu.vn/*"
      ],
      "js": ["sites/studocu.js"],
      "css": ["styles/studocu.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.scribd.com/document/*", "https://scribd.com/document/*"],
      "js": ["sites/scribd.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.slideshare.net/slideshow/*",
        "https://slideshare.net/slideshow/*",
        "https://*.slideshare.net/slideshow/*"
      ],
      "js": ["sites/slideshare.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
